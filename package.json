{
  "name": "browser-sandbox",
  "version": "0.1.0",
  "description": "Build Vite-style project files in the browser and get a Blob URL for iframe loading",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run tsc",
    "tsc": "tsc",
    "dev": "bun run build",
    "example": "bun run build && bunx serve . -p 3000"
  },
  "dependencies": {
    "esbuild-wasm": "^0.24.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "sideEffects": false
}
